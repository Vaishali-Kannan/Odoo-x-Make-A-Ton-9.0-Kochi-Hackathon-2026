-- =============================================================================
-- BRIGHTLOOP SUBSCRIPTION INTELLIGENCE PLATFORM
-- Supabase / PostgreSQL Production Database Schema
-- =============================================================================

-- Enable UUID extension
create extension if not exists "uuid-ossp";

-- 1. CUSTOMERS TABLE
create table if not exists public.customers (
    id uuid default uuid_generate_v4() primary key,
    code text not null unique,
    name text not null,
    contact_person text not null,
    email text not null,
    phone text,
    address text,
    gstin text,
    joined_date date default current_date,
    total_spent numeric(14,2) default 0,
    health text check (health in ('healthy', 'warning', 'danger', 'closed')) default 'healthy',
    health_score integer default 100 check (health_score between 0 and 100),
    health_reason text,
    payment_method text,
    created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 2. SUBSCRIPTION PLANS TABLE
create table if not exists public.plans (
    id text primary key,
    name text not null,
    tier text check (tier in ('starter', 'standard', 'growth', 'enterprise')) default 'standard',
    base_price numeric(12,2) not null,
    billing_cycle text default 'monthly',
    seat_included integer default 5,
    extra_seat_price numeric(10,2) default 1500,
    description text,
    created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 3. SUBSCRIPTIONS TABLE
create table if not exists public.subscriptions (
    id uuid default uuid_generate_v4() primary key,
    subscription_number text not null unique,
    customer_id uuid references public.customers(id) on delete cascade not null,
    plan_id text references public.plans(id) on delete restrict not null,
    billing_cycle text default 'monthly',
    seats integer not null default 5,
    base_price numeric(12,2) not null,
    additional_seats_cost numeric(12,2) default 0,
    discount_amount numeric(12,2) default 0,
    monthly_amount numeric(12,2) not null,
    tax_rate numeric(5,2) default 18.0,
    status text check (status in ('draft', 'quotation', 'confirmed', 'active', 'renewal_failed', 'closed')) default 'active',
    health text check (health in ('healthy', 'warning', 'danger', 'closed')) default 'healthy',
    health_score integer default 95 check (health_score between 0 and 100),
    health_reason text,
    start_date date not null default current_date,
    current_period_start date default current_date,
    current_period_end date,
    next_renewal_date date,
    auto_renew boolean default true,
    created_at timestamp with time zone default timezone('utc'::text, now()) not null,
    updated_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 4. SUBSCRIPTION LIFECYCLE EVENTS (SUBSCRIPTION DNA & TIMELINE)
create table if not exists public.subscription_events (
    id uuid default uuid_generate_v4() primary key,
    subscription_id uuid references public.subscriptions(id) on delete cascade not null,
    stage text check (stage in ('Created', 'Quotation', 'Confirmed', 'Active', 'Renewal', 'Closed')) not null,
    event text not null,
    actor text not null,
    event_date date not null default current_date,
    created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 5. INVOICES TABLE (WITH COMPLETE EXPLAINABILITY FIELDS)
create table if not exists public.invoices (
    id uuid default uuid_generate_v4() primary key,
    invoice_number text not null unique,
    customer_id uuid references public.customers(id) on delete cascade not null,
    subscription_id uuid references public.subscriptions(id) on delete set null,
    issue_date date not null default current_date,
    due_date date not null,
    status text check (status in ('draft', 'due', 'paid', 'overdue', 'cancelled')) default 'due',
    paid_date date,
    payment_method text,
    base_price numeric(12,2) not null,
    additional_seats_cost numeric(12,2) default 0,
    discount_rate numeric(5,2) default 0,
    discount_amount numeric(12,2) default 0,
    discount_reason text,
    taxable_amount numeric(12,2) not null,
    tax_rate numeric(5,2) default 18.0,
    cgst numeric(12,2) not null,
    sgst numeric(12,2) not null,
    tax_amount numeric(12,2) not null,
    total_amount numeric(12,2) not null,
    notes text,
    created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 6. INVOICE LINE ITEMS
create table if not exists public.invoice_line_items (
    id uuid default uuid_generate_v4() primary key,
    invoice_id uuid references public.invoices(id) on delete cascade not null,
    description text not null,
    quantity integer default 1,
    unit_price numeric(12,2) not null,
    amount numeric(12,2) not null
);

-- 7. REVENUE HISTORY (FOR CHARTING)
create table if not exists public.revenue_history (
    id uuid default uuid_generate_v4() primary key,
    month_code text not null, -- e.g. 'Apr', 'May', 'Oct'
    month_label text not null, -- e.g. 'October 2026'
    sort_order integer not null,
    this_year_mrr numeric(14,2) not null,
    last_year_mrr numeric(14,2) not null
);

-- 8. REVENUE DETECTIVE FACTORS (CAUSALITY ATTRIBUTION)
create table if not exists public.revenue_detective_factors (
    id uuid default uuid_generate_v4() primary key,
    factor_type text not null,
    title text not null,
    amount numeric(12,2) not null,
    direction text check (direction in ('positive', 'negative')) not null,
    category text not null,
    customer text not null,
    detail text not null,
    period text default 'October 2026'
);

-- 9. FRAUD & MISTAKE SHIELD ALERTS
create table if not exists public.fraud_alerts (
    id uuid default uuid_generate_v4() primary key,
    severity text check (severity in ('info', 'warning', 'critical')) not null,
    title text not null,
    description text not null,
    affected_customer text not null,
    recommended_action text not null,
    resolved boolean default false,
    created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 10. BUSINESS MEMORY (DECISION AUDIT REPOSITORY)
create table if not exists public.business_memory (
    id uuid default uuid_generate_v4() primary key,
    decision_date date not null default current_date,
    title text not null,
    author text not null,
    reason text not null,
    impact text not null,
    status text default 'Active',
    created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- =============================================================================
-- ROW LEVEL SECURITY (RLS) POLICIES
-- =============================================================================
alter table public.customers enable row level security;
alter table public.plans enable row level security;
alter table public.subscriptions enable row level security;
alter table public.subscription_events enable row level security;
alter table public.invoices enable row level security;
alter table public.invoice_line_items enable row level security;
alter table public.revenue_history enable row level security;
alter table public.revenue_detective_factors enable row level security;
alter table public.fraud_alerts enable row level security;
alter table public.business_memory enable row level security;

