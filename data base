create policy "Allow public read access on invoices" on public.invoices for select using (true);
create policy "Allow public write access on invoices" on public.invoices for all using (true);

create policy "Allow public read access on invoice_line_items" on public.invoice_line_items for select using (true);
create policy "Allow public write access on invoice_line_items" on public.invoice_line_items for all using (true);

create policy "Allow public read access on revenue_history" on public.revenue_history for select using (true);
create policy "Allow public write access on revenue_history" on public.revenue_history for all using (true);

create policy "Allow public read access on revenue_detective_factors" on public.revenue_detective_factors for select using (true);
