NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
BUSINESS_TIMEZONE=Asia/Kolkata
# PostgreSQL Database Connection
# If using a local PostgreSQL: postgresql://<user>:<password>@localhost:5432/subscriptiq?schema=public
# If using a cloud database (Supabase/Neon/Railway), paste the connection string here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscriptiq?schema=public"
# Authentication & Security
JWT_SECRET=super-secure-subscriptiq-jwt-secret-min-32-chars-key
JWT_EXPIRES_IN=1d
# Email / Notifications (Mock or SMTP)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
EMAIL_FROM=billing@subscriptiq.com
# Automation Settings
AUTOMATION_ENABLED=true
REMINDER_DAYS_BEFORE=7,3,1
